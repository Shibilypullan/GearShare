rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * GEARSHARE SECURITY RULES
     */

    // --- HELPER FUNCTIONS ---

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isFieldOwner(field) {
      return isSignedIn() && request.auth.uid == field;
    }

    function isParticipant(participants) {
      return isSignedIn() && (request.auth.uid in participants);
    }

    function isTransactionParty(data) {
      return isSignedIn() && (request.auth.uid == data.ownerId || request.auth.uid == data.borrowerId);
    }

    // --- COLLECTION RULES ---

    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if false;
    }

    match /items/{itemId} {
      allow get, list: if true;
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.ownerId == request.auth.uid;
    }

    match /transactions/{transactionId} {
      allow get, list: if isSignedIn() && (resource.data.ownerId == request.auth.uid || resource.data.borrowerId == request.auth.uid);
      allow create: if isSignedIn() && (request.resource.data.ownerId == request.auth.uid || request.resource.data.borrowerId == request.auth.uid);
      allow update, delete: if isSignedIn() && (resource.data.ownerId == request.auth.uid || resource.data.borrowerId == request.auth.uid);
    }

    match /reviews/{reviewId} {
      allow get, list: if true;
      allow create: if isSignedIn() && request.resource.data.reviewerId == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.reviewerId == request.auth.uid;
    }

    match /conversations/{conversationId} {
      // Explicitly allow list if the user filters by their own UID in the participantUserIds array
      allow list: if isSignedIn() && (request.auth.uid in resource.data.participantUserIds);
      allow get: if isSignedIn() && (request.auth.uid in resource.data.participantUserIds);
      allow create: if isSignedIn() && (request.auth.uid in request.resource.data.participantUserIds);
      allow update: if isSignedIn() && (request.auth.uid in resource.data.participantUserIds);
      allow delete: if isSignedIn() && (request.auth.uid in resource.data.participantUserIds);
    }

    match /conversations/{conversationId}/messages/{messageId} {
      allow get, list: if isSignedIn() && (request.auth.uid in resource.data.participantUserIds);
      allow create: if isSignedIn() && (request.auth.uid in request.resource.data.participantUserIds) && request.resource.data.senderId == request.auth.uid;
      allow update, delete: if false; 
    }

    match /users/{userId}/notifications/{notificationId} {
      allow read, write: if isOwner(userId);
    }
  }
}
